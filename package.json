{
	"name": "lemmary-api",
	"version": "0.1.0",
	"description": "Lemmary — Production management API for makers",
	"author": "Ryan Brockhoff",
	"private": true,
	"type": "module",
	"license": "UNLICENSED",
	"engines": {
		"node": ">=24"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"scripts": {
		"commit": "cz",
		"dev": "tsx watch server/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:changed": "git diff --name-only --relative | xargs prettier --write",
		"deploy:shopify": "shopify app deploy",
		"migrate:latest": "tsx server/db/migrate.ts",
		"migrate:down": "tsx server/db/migrate.ts down",
		"migrate:down:all": "tsx server/db/migrate.ts down:all",
		"migrate:prod": "NODE_ENV=production tsx server/db/migrate.ts",
		"seed": "tsx server/db/seeds/01_seed_dev_store.ts",
		"seed:demo": "tsx server/db/seeds/02_seed_demo_store.ts",
		"db:reset": "psql -d assemblr_dev -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && npm run migrate:latest && npm run seed",
		"test": "NODE_ENV=test npm run test:setup && NODE_ENV=test vitest run",
		"test:watch": "NODE_ENV=test vitest",
		"test:coverage": "NODE_ENV=test npm run test:setup && NODE_ENV=test vitest run --coverage",
		"test:setup": "NODE_ENV=test npm run test:reset && NODE_ENV=test npm run test:migrate && NODE_ENV=test npm run test:seed",
		"test:migrate": "NODE_ENV=test tsx server/db/migrate.ts",
		"test:reset": "NODE_ENV=test tsx server/db/migrate.ts down:all",
		"test:seed": "NODE_ENV=test tsx server/db/seeds/00_seed_test_store.ts",
		"prepare": "husky"
	},
	"dependencies": {
		"@fastify/cookie": "^11.0.0",
		"@fastify/cors": "^11.2.0",
		"@fastify/rate-limit": "^11.0.0",
		"@fastify/swagger": "^9.7.0",
		"@fastify/swagger-ui": "^5.2.6",
		"@sentry/node": "^10.55.0",
		"@supabase/supabase-js": "^2.45.0",
		"dotenv": "^17.3.1",
		"fastify": "^5.7.4",
		"fastify-raw-body": "^5.0.0",
		"fastify-type-provider-zod": "^6.1.0",
		"kysely": "^0.28.11",
		"pg": "^8.18.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.4.0",
		"@types/node": "^25.3.0",
		"@types/pg": "^8.16.0",
		"@vitest/coverage-v8": "^4.1.6",
		"commitizen": "^4.3.1",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "^10.0.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.4",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.8.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.6"
	}
}
